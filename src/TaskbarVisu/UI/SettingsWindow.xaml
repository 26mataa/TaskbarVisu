<Window x:Class="TaskbarVisu.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TaskbarVisu — Paramètres"
        Width="840" Height="700" MinWidth="660" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        Icon="/Assets/TaskbarVisu.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="Tabs" Margin="12,8,12,0">
            <TabItem x:Name="TabGeneral" Header="Général">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="GeneralPanel" Margin="16,8,24,16" />
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TabAppearance" Header="Apparence">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="AppearancePanel" Margin="16,8,24,16" />
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TabLayout" Header="Disposition">
                <ScrollViewer x:Name="LayoutScroll" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="LayoutRoot" Margin="16,8,24,16" />
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="TabModules" Header="Modules">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ModulesPanel" Margin="16,8,24,16" />
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Grid x:Name="Footer" Grid.Row="1" Margin="16,10,16,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" Opacity="0.7"
                       TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="ResetAllButton" Content="Tout réinitialiser" Margin="0,0,8,0" Click="OnResetAll" />
                <Button x:Name="CloseButton" Content="Fermer" MinWidth="90" Click="OnCloseClick" />
            </StackPanel>
        </Grid>
        <!-- Guide de démarrage : remplace les onglets le temps de ses cinq étapes. -->
        <Grid x:Name="WelcomeRoot" Grid.RowSpan="2" Visibility="Collapsed" />
    </Grid>
</Window>
